# Anthropic API Key (Required for web search tools)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI API Key (Required for the main agent)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# LibSQL/Turso (Optional - uses local SQLite by default)
# For distributed memory, sign up at: https://turso.tech/
LIBSQL_URL=file:local.db
# LIBSQL_AUTH_TOKEN=your_turso_token_here

# Next.js (Optional)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
